# ── 1. Entorno y Puerto del Servidor Web ──────────────────────────────────────
NODE_ENV=development
PORT=5050

# ── 2. Conexión a Base de Datos MySQL ─────────────────────────────────────────
# En Desarrollo (Docker contenedor ep_ema_mysql en puerto 3307 - usar 127.0.0.1 para evitar cierres IPv6 en Windows):
DATABASE_URL="mysql://ep_ema_user:ep_ema_pass@127.0.0.1:3307/ep_ema_db?connection_limit=15&pool_timeout=30&connect_timeout=20"

# En Producción (MySQL Nativo en Windows 10 Pro - Puerto por defecto 3306):
# DATABASE_URL="mysql://root:TU_PASSWORD_MYSQL@127.0.0.1:3306/ep_ema_db?connection_limit=15&pool_timeout=30&connect_timeout=20"

# ── 3. Credenciales del Superusuario (SUPERADMIN) para Sembrado Inicial ───────
# El script toma SUPERADMIN_PASSWORD en texto plano y lo cifra con bcrypt(10) al insertar en BD
SUPERADMIN_ID="u-super"
SUPERADMIN_CEDULA="admin"
SUPERADMIN_NOMBRES="Administrador"
SUPERADMIN_APELLIDOS="Sistema"
SUPERADMIN_CORREO="sistema.epema@gmail.com"
SUPERADMIN_PASSWORD="Ravine.Snooze.Cover9.Defendant"

# ── 4. Autenticación y Criptografía (JWT con librería 'jose') ─────────────────
JWT_SECRET="epmma_jwt_secret_key_minimum_32_characters_2026_prod"
JWT_EXPIRES_IN="8h"

# ── 5. Servicio de Correo Transaccional (Gmail SMTP) ──────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="sistema.epema@gmail.com"
SMTP_PASS="tu_contraseña_de_aplicacion_aqui"
EMAIL_FROM="EP-EMA Sistema de Gestión <sistema.epema@gmail.com>"# ── 1. Entorno y Puerto del Servidor Web ──────────────────────────────────────
